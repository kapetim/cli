# Direct-package version pins for the cli toolchain image.
# Alpine (fixed release). Version numbers only — no sha256/digest pins.
# apk pins are exact; third-party tools are pinned by release version.

# --- alpine base (fixed release) ---
ALPINE_VERSION=3.21

# --- core (shared base) ---
APK_COREUTILS=9.5-r2
APK_CURL=8.14.1-r2
APK_CA_CERTIFICATES=20260909-r0

# --- go (cli build + in-image toolchain) ---
APK_GO=1.23.9-r0

# --- tools ---
APK_YQ_GO=4.44.5-r5
APK_SHELLCHECK=0.10.0-r1
APK_ACTIONLINT=1.7.4-r5

# --- tools (pinned release binaries; not in apk) ---
HADOLINT_VERSION=2.15.1
